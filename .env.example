# ===== smd-web-hmi 环境变量模板 =====
# 复制为 backend/.env 后按现场修改。.env 不得提交（见 .gitignore）。

# ---- 后端服务 ----
SMD_HOST=0.0.0.0
SMD_PORT=8000
SMD_DB_PATH=./data/smd.db
# JWT 密钥：首次启动若为空会自动生成；生产请填入至少 32 字节随机串
SMD_JWT_SECRET=
SMD_JWT_EXPIRE_MINUTES=480

# ---- HostComm（与 STM32 控制板通信）----
HOSTCOMM_HOST=192.168.1.100
HOSTCOMM_PORT=34211
HOSTCOMM_HEARTBEAT_INTERVAL=2
HOSTCOMM_TIMEOUT_COUNT=3
HOSTCOMM_COMMAND_TIMEOUT=3
# true = 启动时连接本地 Mock Server（开发/无控制板时使用）
HOSTCOMM_MOCK=false

# ---- 前端（Vite，构建期注入）----
VITE_API_BASE=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/realtime
