# ===== smd-web-hmi 环境变量模板 =====
# 复制为 backend/.env 后按现场修改。.env 不得提交（见 .gitignore）。

# ---- 后端服务 ----
SMD_HOST=127.0.0.1
# 局域网监听改为明确网卡地址或 0.0.0.0，并配置绝对路径及客户端信任。
SMD_TLS_CERTFILE=
SMD_TLS_KEYFILE=
SMD_PORT=8000
SMD_DB_PATH=./data/smd.db
# JWT 密钥：HOSTCOMM_MOCK=false 时必须配置至少 32 字节随机串，否则拒绝启动。
# 仅 HOSTCOMM_MOCK=true 的开发环境允许留空（会告警并生成进程级临时密钥）。
SMD_JWT_SECRET=
SMD_JWT_EXPIRE_MINUTES=480
# 首次生产启动必须通过以下二选一方式提供至少 12 字符的一次性管理员口令；首次登录后立即修改。
# 若数据库中已存在 admin，后续可清空。Windows 安装器使用受 ACL 保护的文件方式。
SMD_BOOTSTRAP_ADMIN_PASSWORD=
SMD_BOOTSTRAP_ADMIN_PASSWORD_FILE=
# 状态快照保留最近 24 小时，每 5 分钟批量清理一次
SMD_DEVICE_STATUS_RETENTION_HOURS=24
SMD_DEVICE_STATUS_CLEANUP_INTERVAL_SECONDS=300
# SQLite 在线备份与临时导出清理
SMD_BACKUP_INTERVAL_HOURS=24
SMD_BACKUP_RETENTION_DAYS=30
SMD_EXPORT_RETENTION_DAYS=7
SMD_MAINTENANCE_INTERVAL_SECONDS=3600
SMD_STORAGE_MIN_FREE_BYTES=1073741824
# 登录防护：每 IP 每 60 秒最多 10 次；账户连续失败 5 次锁定 15 分钟
SMD_LOGIN_RATE_LIMIT=10
SMD_LOGIN_RATE_WINDOW_SECONDS=60
SMD_LOGIN_MAX_FAILURES=5
SMD_LOGIN_LOCK_MINUTES=15
# 单用户同时建立的实时 WebSocket 连接上限（1–20）
SMD_WS_MAX_CONNECTIONS_PER_USER=3
SMD_WS_AUTH_TIMEOUT_SECONDS=5
SMD_WS_IDLE_TIMEOUT_SECONDS=45
SMD_WS_MAX_MESSAGE_BYTES=65536
SMD_WS_RATE_LIMIT_PER_MINUTE=120
# 生产同源部署保持为空；跨域调试时填写逗号分隔的完整 Origin（不得含路径）。
SMD_CORS_ORIGINS=

# ---- HostComm（与 STM32 控制板通信）----
HOSTCOMM_HOST=192.168.1.100
HOSTCOMM_PORT=34211
HOSTCOMM_HEARTBEAT_INTERVAL=2
HOSTCOMM_TIMEOUT_COUNT=3
HOSTCOMM_COMMAND_TIMEOUT=3
# true = 启动时连接本地 Mock Server（开发/无控制板时使用）
HOSTCOMM_MOCK=false

# ---- 前端静态托管（生产同源部署）----
# vite build 产物目录：留空时自动探测仓库内 frontend/dist；
# Windows 安装器写入版本目录的绝对路径（见 deploy/windows/）
SMD_FRONTEND_DIST=

# ---- 前端（Vite，构建期注入；仅前后端分离调试时需要）----
# 生产为同源部署（后端托管 dist），请保持两项为空，代码内已有 location 回退；
# 开发用 Vite dev server 时由 vite.config.js 的 proxy 转发，同样无需配置
VITE_API_BASE=
VITE_WS_URL=
