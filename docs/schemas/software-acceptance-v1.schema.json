{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SMD software-stable release acceptance v1",
  "type": "object",
  "required": [
    "schema_version",
    "version",
    "commit",
    "ci_run_id",
    "release_scope",
    "artifacts",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "ci_run_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "release_scope": {
      "const": "software-stable"
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "installer",
        "bench",
        "bench_manifest",
        "bench_acceptance",
        "windows_acceptance"
      ],
      "properties": {
        "installer": {
          "$ref": "#/$defs/artifact"
        },
        "bench": {
          "$ref": "#/$defs/artifact"
        },
        "bench_manifest": {
          "$ref": "#/$defs/artifact"
        },
        "bench_acceptance": {
          "$ref": "#/$defs/artifact"
        },
        "windows_acceptance": {
          "$ref": "#/$defs/artifact"
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "win10_win11_desktop_unverified",
          "firmware_unverified",
          "physical_interlocks_unverified",
          "gb_conformance_unverified"
        ]
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
