{
  "name": "smd-web-hmi-frontend",
  "version": "0.3.0-rc.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc -p tsconfig.api.json --noEmit",
    "types:generate": "openapi-typescript src/api/generated/openapi.json -o src/api/generated/schema.d.ts",
    "types:check": "openapi-typescript src/api/generated/openapi.json -o src/api/generated/schema.d.ts --check",
    "api:schema": "python scripts/export-openapi.py"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "chart.js": "^4.4.7",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.9.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vite": "~6.4.3",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
